diff --git a/packages/next/src/server/app-render/script-integrity.ts b/packages/next/src/server/app-render/script-integrity.ts
new file mode 100644
index 00000000..cdd94a77
--- /dev/null
+++ b/packages/next/src/server/app-render/script-integrity.ts
@@ -0,0 +1,17 @@
+/** Fail closed for an admitted SRI build; non-SRI/development stays explicit. */
+export function scriptIntegrity(
+  manifest: Readonly<Record<string, string>> | undefined,
+  file: string
+): string | undefined {
+  if (manifest === undefined) return undefined
+  const integrity = Object.prototype.hasOwnProperty.call(manifest, file)
+    ? manifest[file]
+    : undefined
+  if (
+    typeof integrity !== 'string' ||
+    !/^(?:sha256-[A-Za-z0-9+/]{43}=|sha384-[A-Za-z0-9+/]{64}|sha512-[A-Za-z0-9+/]{86}==)$/.test(integrity)
+  ) {
+    throw new Error(`SRI: missing or malformed integrity for ${file}`)
+  }
+  return integrity
+}
