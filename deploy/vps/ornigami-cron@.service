[Unit]
Description=Ornigami %i cron dispatch
After=ornigami.service
Wants=ornigami.service

[Service]
Type=oneshot
User=ornigami
Group=ornigami
WorkingDirectory=/opt/ornigami/current
EnvironmentFile=/etc/ornigami/runtime.env
StateDirectory=ornigami-cron
StateDirectoryMode=0750
ExecStart=/usr/bin/flock --nonblock /var/lib/ornigami-cron/dispatch.lock /usr/bin/node /opt/ornigami/current/scripts/vps-cron-dispatch.mjs %i
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ornigami-cron

[Install]
# Timers pull in this template service; enable the timers, not service instances.
