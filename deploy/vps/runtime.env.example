# Install as /etc/ornigami/runtime.env, owned by root:root with mode 0600.
# systemd reads this file before dropping privileges to the ornigami account.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://ornigami.com
AUTH_URL=https://ornigami.com

# Required by core application features. Uncomment and fill values in the root-owned file.
# Do not leave optional variables assigned to an empty string; the app validates some of them.
# DATABASE_URL=postgresql://user:password@db.example/ornigami?sslmode=require
# AUTH_SECRET=<generate-a-private-random-secret>
# TOKEN_ENCRYPTION_KEY=<generate-a-private-encryption-key>
# AUTH_URL=https://ornigami.com
# GOOGLE_CLIENT_ID=<oauth-client-id>
# GOOGLE_CLIENT_SECRET=<oauth-client-secret>

# Configure only the integrations that are enabled for this deployment.
# OPENAI_API_KEY=<provider-key>
# STRIPE_SECRET_KEY=<live-secret-key>
# STRIPE_WEBHOOK_SECRET=<webhook-signing-secret>
# STRIPE_PRICE_REPLIES_MONTHLY=<price-id>
# STRIPE_PRICE_REPLIES_ANNUAL=<price-id>
# STRIPE_PRICE_BOOSTER_MONTHLY=<price-id>
# STRIPE_PRICE_BOOSTER_ANNUAL=<price-id>
# STRIPE_PRICE_COMPLETE_MONTHLY=<price-id>
# STRIPE_PRICE_COMPLETE_ANNUAL=<price-id>
# CRON_SECRET=<generate-a-private-random-secret>
# RESEND_API_KEY=<provider-key>
# RESEND_WEBHOOK_SECRET=<webhook-signing-secret>
# EMAIL_FROM=<verified-sender-address>
# REPLY_TO_EMAIL=<support-address>
# REVIEW_BOOSTER_UNSUBSCRIBE_SECRET=<generate-a-private-random-secret>

# Feature flags remain disabled until their independent operational gates are met.
RESEND_RECONCILIATION_ENABLED=false
PRIVACY_ACCOUNT_DELETION_ENABLED=false
PRIVACY_RETENTION_ENABLED=false
PRIVACY_RETENTION_APPLY=false

# Optional telemetry.
# NEXT_PUBLIC_SENTRY_DSN=<public-project-dsn>
