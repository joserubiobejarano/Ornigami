# Reference only. Values come from protected staging environment references.
# The bcrypt hash must never be committed. Escape Compose dollars as needed.
{
	email {$ACME_EMAIL}
}

{$STAGING_HOST} {
	encode zstd gzip

	basic_auth {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up -X-Real-IP
		header_up -X-Vercel-Forwarded-For
		header_up -CF-Connecting-IP
		header_up -Forwarded
	}
}
