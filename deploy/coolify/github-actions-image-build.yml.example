name: Ornigami external image rehearsal (template)

# This file is intentionally outside .github/workflows. Copy/review it there only
# after the repository owner accepts the external builder and its source inputs.
on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: Exact public source commit to build (40 lowercase hex characters)
        required: true
        type: string
      package_lock_sha256:
        description: Expected SHA-256 of package-lock.json at source_sha
        required: true
        type: string

permissions: {}

concurrency:
  group: ornigami-external-image-build
  cancel-in-progress: false

jobs:
  build-validate-scan:
    name: Build, disconnected smoke check, and scan
    if: github.repository == 'joserubiobejarano/Ornigami' && github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    steps:
      - name: Validate inputs and fetch exact public source
        shell: bash
        env:
          SOURCE_SHA: ${{ inputs.source_sha }}
          EXPECTED_LOCK_SHA256: ${{ inputs.package_lock_sha256 }}
        run: |
          set -Eeuo pipefail
          [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]]
          [[ "$EXPECTED_LOCK_SHA256" =~ ^[0-9a-f]{64}$ ]]
          repo='https://github.com/joserubiobejarano/Ornigami.git'
          mkdir "$RUNNER_TEMP/source"
          git -C "$RUNNER_TEMP/source" init --quiet
          git -C "$RUNNER_TEMP/source" remote add origin "$repo"
          git -C "$RUNNER_TEMP/source" fetch --quiet --no-tags --depth=1 origin "$SOURCE_SHA"
          git -C "$RUNNER_TEMP/source" checkout --quiet --detach FETCH_HEAD
          actual_sha=$(git -C "$RUNNER_TEMP/source" rev-parse HEAD)
          [[ "$actual_sha" == "$SOURCE_SHA" ]]
          [[ -z "$(git -C "$RUNNER_TEMP/source" status --porcelain --untracked-files=all)" ]]
          actual_lock_sha=$(sha256sum "$RUNNER_TEMP/source/package-lock.json" | cut -d' ' -f1)
          [[ "$actual_lock_sha" == "$EXPECTED_LOCK_SHA256" ]]
          {
            printf '%s\n' '### Source admission'
            printf '%s\n' "- Commit: \`$actual_sha\`"
            printf '%s\n' "- package-lock.json SHA-256: \`$actual_lock_sha\`"
            printf '%s\n' '- Checkout: detached exact commit; clean before build'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Verify runner and Docker Buildx
        shell: bash
        run: |
          set -Eeuo pipefail
          [[ "$(uname -m)" == x86_64 ]]
          docker info >/dev/null
          docker buildx version
          docker buildx ls
          cpu_count=$(getconf _NPROCESSORS_ONLN)
          total_mib=$(awk '/^MemTotal:/ {print int($2 / 1024)}' /proc/meminfo)
          available_mib=$(awk '/^MemAvailable:/ {print int($2 / 1024)}' /proc/meminfo)
          free_disk_bytes=$(df -PB1 "$RUNNER_TEMP" | awk 'NR == 2 {print $4}')
          {
            printf '%s\n' '### Runner preflight'
            printf '%s\n' "- Online CPUs: ${cpu_count} (minimum 4)"
            printf '%s\n' "- Total memory: ${total_mib} MiB (minimum 14336 MiB)"
            printf '%s\n' "- Available memory before build: ${available_mib} MiB (minimum 12288 MiB)"
            printf '%s\n' "- Free runner disk before build: ${free_disk_bytes} bytes (minimum 10737418240)"
          } >> "$GITHUB_STEP_SUMMARY"
          [[ "$cpu_count" =~ ^[0-9]+$ && "$cpu_count" -ge 4 ]]
          [[ "$total_mib" =~ ^[0-9]+$ && "$total_mib" -ge 14336 ]]
          [[ "$available_mib" =~ ^[0-9]+$ && "$available_mib" -ge 12288 ]]
          [[ "$free_disk_bytes" =~ ^[0-9]+$ && "$free_disk_bytes" -ge 10737418240 ]]

      - name: Create bounded serial BuildKit builder
        shell: bash
        run: |
          set -Eeuo pipefail
          builder='ornigami-external-rehearsal'
          if docker buildx ls --format '{{.Name}}' | grep -Fxq "$builder"; then
            echo 'Refusing to reuse an existing builder.' >&2
            exit 1
          fi
          printf '[worker.oci]\n  max-parallelism = 1\n' > "$RUNNER_TEMP/buildkitd.toml"
          docker buildx create --name "$builder" --driver docker-container \
            --driver-opt 'image=moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea,memory=8g,memory-swap=8g,cpu-quota=300000,cpu-period=100000' \
            --buildkitd-config "$RUNNER_TEMP/buildkitd.toml" --use --bootstrap
          mapfile -t ids < <(docker ps --filter name=buildx_buildkit_ornigami-external-rehearsal --format '{{.ID}}')
          [[ ${#ids[@]} -eq 1 ]]
          docker inspect "${ids[0]}" --format 'memory={{.HostConfig.Memory}} memory_swap={{.HostConfig.MemorySwap}} cpu_quota={{.HostConfig.CpuQuota}} cpu_period={{.HostConfig.CpuPeriod}}'
          [[ "$(docker inspect "${ids[0]}" --format '{{.HostConfig.Memory}}')" == 8589934592 ]]
          [[ "$(docker inspect "${ids[0]}" --format '{{.HostConfig.MemorySwap}}')" == 8589934592 ]]
          [[ "$(docker inspect "${ids[0]}" --format '{{.HostConfig.CpuQuota}}')" == 300000 ]]
          [[ "$(docker inspect "${ids[0]}" --format '{{.HostConfig.CpuPeriod}}')" == 100000 ]]
          docker exec "${ids[0]}" sh -c 'printf "memory.max="; cat /sys/fs/cgroup/memory.max; printf "memory.swap.max="; cat /sys/fs/cgroup/memory.swap.max; printf "cpu.max="; cat /sys/fs/cgroup/cpu.max'
          [[ "$(docker exec "${ids[0]}" cat /sys/fs/cgroup/memory.max)" == 8589934592 ]]
          [[ "$(docker exec "${ids[0]}" cat /sys/fs/cgroup/memory.swap.max)" == 0 ]]
          [[ "$(docker exec "${ids[0]}" cat /sys/fs/cgroup/cpu.max)" == '300000 100000' ]]
          {
            printf '%s\n' '### BuildKit cgroup limits'
            printf '%s\n' '- memory.max: 8589934592 bytes; memory.swap.max: 0 bytes (Docker memory and memory-swap both capped at 8 GiB total)'
            printf '%s\n' '- cpu.max: 300000 100000; BuildKit OCI worker max-parallelism: 1'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Build local Linux amd64 image
        id: image_build
        shell: bash
        env:
          SOURCE_SHA: ${{ inputs.source_sha }}
        run: |
          set -Eeuo pipefail
          build_start_epoch=$(date +%s)
          build_start_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          echo "build_start_epoch=$build_start_epoch" >> "$GITHUB_OUTPUT"
          echo "build_start_utc=$build_start_utc" >> "$GITHUB_OUTPUT"
          build_rc=0
          timeout --signal=TERM --kill-after=30s 30m docker buildx build \
            --builder ornigami-external-rehearsal \
            --platform linux/amd64 \
            --load \
            --tag "ornigami:rehearsal-${SOURCE_SHA}" \
            --build-arg NEXT_PUBLIC_APP_URL=https://rehearsal.invalid \
            --build-arg "ORNIGAMI_SOURCE_SHA=${SOURCE_SHA}" \
            --build-arg ORNIGAMI_BUILD_HEAP_MIB=4096 \
            --build-arg ORNIGAMI_BUILD_MEMORY_OPTIMIZATIONS=true \
            --build-arg ORNIGAMI_BUILD_DISABLE_SOURCEMAPS=false \
            --build-arg ORNIGAMI_BUILD_WEBPACK_WORKER=false \
            "$RUNNER_TEMP/source" || build_rc=$?
          build_end_epoch=$(date +%s)
          build_end_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          build_seconds=$((build_end_epoch - build_start_epoch))
          echo "build_end_epoch=$build_end_epoch" >> "$GITHUB_OUTPUT"
          echo "build_end_utc=$build_end_utc" >> "$GITHUB_OUTPUT"
          echo "build_seconds=$build_seconds" >> "$GITHUB_OUTPUT"
          echo "build_exit_code=$build_rc" >> "$GITHUB_OUTPUT"
          builder_id=$(docker ps -q --filter name=buildx_buildkit_ornigami-external-rehearsal | head -n1)
          if [[ -n "$builder_id" ]]; then
            docker exec "$builder_id" sh -c '
              for path in memory.max memory.swap.max memory.peak memory.events cpu.max cpu.stat; do
                printf "==%s==\\n" "$path"
                cat "/sys/fs/cgroup/$path"
              done
            ' > "$RUNNER_TEMP/builder-after-build.txt"
            {
              printf '\n### Build result and cgroup counters\n\n'
              printf '%s\n' "- Build interval: ${build_start_utc} to ${build_end_utc} UTC (${build_seconds} seconds)"
              printf '%s\n' "- Build command exit code: ${build_rc}"
              printf '%s\n' '- Observed builder counters immediately after build:'
              printf '%s\n' '```text'
              cat "$RUNNER_TEMP/builder-after-build.txt"
              printf '%s\n' '```'
            } >> "$GITHUB_STEP_SUMMARY"
          else
            printf '\n### Build result\n\n- Build interval: %s to %s UTC (%s seconds)\n- Build command exit code: %s\n- Builder cgroup counters: unavailable; builder container not running\n' \
              "$build_start_utc" "$build_end_utc" "$build_seconds" "$build_rc" >> "$GITHUB_STEP_SUMMARY"
          fi
          [[ "$build_rc" -eq 0 ]]
          image="ornigami:rehearsal-${SOURCE_SHA}"
          image_revision=$(docker image inspect "$image" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')
          image_platform=$(docker image inspect "$image" --format '{{.Os}}/{{.Architecture}}')
          image_id=$(docker image inspect "$image" --format '{{.Id}}')
          [[ "$image_revision" == "$SOURCE_SHA" && "$image_platform" == linux/amd64 ]]
          printf '\n### Local image identity\n\n- Image ID: `%s`\n- Platform: `%s`\n- Source revision label: `%s`\n- Delivery: local runner only; no artifact or image publication\n' \
            "$image_id" "$image_platform" "$image_revision" >> "$GITHUB_STEP_SUMMARY"

      - name: Disconnected local health smoke check
        shell: bash
        env:
          SOURCE_SHA: ${{ inputs.source_sha }}
        run: |
          set -Eeuo pipefail
          image="ornigami:rehearsal-${SOURCE_SHA}"
          name='ornigami-external-smoke'
          docker run --detach --name "$name" --network none --read-only \
            --memory 768m --memory-swap 768m --cpus 0.75 \
            --cap-drop ALL --security-opt no-new-privileges --init --pids-limit 128 \
            --env AUTH_SECRET=rehearsal-only-synthetic-runtime-secret-not-for-use \
            --env GOOGLE_CLIENT_ID=rehearsal.invalid \
            --env GOOGLE_CLIENT_SECRET=rehearsal-only-placeholder-not-a-provider-credential \
            --env ORNIGAMI_COOLIFY_CRON_ENABLED=false \
            --env ORNIGAMI_COOLIFY_CRON_REVIEW_BOOSTER_ENABLED=false \
            --env ORNIGAMI_COOLIFY_CRON_REVIEW_REPLIES_ENABLED=false \
            --env ORNIGAMI_COOLIFY_CRON_PRIVACY_ENABLED=false \
            --env ORNIGAMI_COOLIFY_REPLIES_ACCEPTED=false \
            --env PRIVACY_RETENTION_ENABLED=false \
            --env PRIVACY_RETENTION_APPLY=false \
            --env PRIVACY_ACCOUNT_DELETION_ENABLED=false \
            --env OPENAI_ENABLED=false \
            --env RESEND_RECONCILIATION_ENABLED=false \
            --tmpfs /tmp:rw,noexec,nosuid,size=32m \
            --tmpfs /app/.next/cache:rw,nosuid,size=64m,uid=1000,gid=1000 \
            "$image"
          cleanup() { docker rm -f "$name" >/dev/null 2>&1 || true; }
          trap cleanup EXIT
          for _ in $(seq 1 60); do
            state=$(docker inspect "$name" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}')
            [[ "$state" == healthy ]] && break
            [[ "$state" != unhealthy && "$state" != missing ]]
            sleep 2
          done
          [[ "$(docker inspect "$name" --format '{{.State.Health.Status}}')" == healthy ]]
          echo '- Disconnected Linux runtime healthcheck: passed; no ports published' >> "$GITHUB_STEP_SUMMARY"

      - name: Download and verify pinned Trivy scanner
        shell: bash
        run: |
          set -Eeuo pipefail
          cd "$RUNNER_TEMP"
          curl --fail --silent --show-error --location \
            --output trivy_0.76.0_Linux-64bit.tar.gz \
            https://github.com/aquasecurity/trivy/releases/download/v0.76.0/trivy_0.76.0_Linux-64bit.tar.gz
          curl --fail --silent --show-error --location \
            --output trivy_0.76.0_checksums.txt \
            https://github.com/aquasecurity/trivy/releases/download/v0.76.0/trivy_0.76.0_checksums.txt
          grep -Fx 'e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7  trivy_0.76.0_Linux-64bit.tar.gz' trivy_0.76.0_checksums.txt >/dev/null
          echo 'e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7  trivy_0.76.0_Linux-64bit.tar.gz' | sha256sum --check --status
          tar -xzf trivy_0.76.0_Linux-64bit.tar.gz trivy
          chmod 0755 trivy
          ./trivy --version
          {
            printf '%s\n' '### Scanner verification'
            printf '%s\n' '- Trivy 0.76.0 Linux amd64 archive checksum verified against the official release checksum file:'
            printf '%s\n' '  https://github.com/aquasecurity/trivy/releases/download/v0.76.0/trivy_0.76.0_checksums.txt'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Scan local image archive for OS and language vulnerabilities
        shell: bash
        env:
          SOURCE_SHA: ${{ inputs.source_sha }}
        run: |
          set -Eeuo pipefail
          image="ornigami:rehearsal-${SOURCE_SHA}"
          image_id=$(docker image inspect "$image" --format '{{.Id}}')
          docker save --output "$RUNNER_TEMP/ornigami-image.tar" "$image"
          "$RUNNER_TEMP/trivy" image --input "$RUNNER_TEMP/ornigami-image.tar" \
            --scanners vuln --format json --exit-code 0 --output "$RUNNER_TEMP/trivy.json" --no-progress
          python3 - "$RUNNER_TEMP/trivy.json" "$GITHUB_STEP_SUMMARY" "$image_id" <<'PY'
          import collections, json, pathlib, sys
          report = json.loads(pathlib.Path(sys.argv[1]).read_text())
          expected_image_id = sys.argv[3]
          if not isinstance(report, dict) or type(report.get("SchemaVersion")) is not int or report["SchemaVersion"] != 2:
              raise SystemExit("Trivy report SchemaVersion is missing or unsupported; refusing to accept the scan")
          if report.get("ArtifactType") != "container_image":
              raise SystemExit("Trivy report ArtifactType is not container_image; refusing to accept the scan")
          metadata = report.get("Metadata")
          if not isinstance(metadata, dict) or metadata.get("ImageID") != expected_image_id:
              raise SystemExit("Trivy report Metadata.ImageID does not match the built image; refusing to accept the scan")
          results = report.get("Results")
          if not isinstance(results, list) or not results:
              raise SystemExit("Trivy returned missing or empty Results; refusing to accept the scan")
          counts = collections.Counter()
          findings = []
          seen_classes = set()
          expected_types = {"os-pkgs": {"debian"}, "lang-pkgs": {"npm", "node-pkg"}}
          seen_node_type = False
          for result in results:
              if not isinstance(result, dict) or not isinstance(result.get("Target"), str) or not result["Target"]:
                  raise SystemExit("Trivy returned a malformed result entry; refusing to accept the scan")
              result_class = result.get("Class")
              result_type = result.get("Type")
              if not isinstance(result_class, str) or not isinstance(result_type, str) or result_class not in expected_types or result_type not in expected_types[result_class]:
                  raise SystemExit("Trivy returned an unrecognized result class/type; refusing to accept the scan")
              seen_classes.add(result_class)
              if result_class == "lang-pkgs":
                  seen_node_type = True
              vulnerabilities = result.get("Vulnerabilities")
              if vulnerabilities is None:
                  continue
              if not isinstance(vulnerabilities, list):
                  raise SystemExit("Trivy returned malformed Vulnerabilities; expected absent, null, or a list")
              for item in vulnerabilities:
                  if not isinstance(item, dict) or any(not isinstance(item.get(key), str) or not item[key].strip() for key in ("Severity", "VulnerabilityID", "PkgName")):
                      raise SystemExit("Trivy returned a malformed vulnerability entry; refusing to accept the scan")
                  severity = item["Severity"].upper()
                  counts[severity] += 1
                  findings.append((severity, item["PkgName"], item["VulnerabilityID"]))
          if seen_classes != set(expected_types) or not seen_node_type:
              raise SystemExit("Trivy report lacks OS or Node.js package inventory coverage; refusing to accept the scan")
          if any(level not in {"CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"} for level, _, _ in findings):
              raise SystemExit("Trivy returned an unknown severity; refusing to accept the scan")
          with open(sys.argv[2], "a", encoding="utf-8") as out:
              out.write("\n### Trivy 0.76.0 image scan\n\n")
              out.write("| Severity | Findings |\n| --- | ---: |\n")
              for level in ("CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"):
                  out.write(f"| {level} | {counts[level]} |\n")
              out.write("\nNo image was pushed or published by this workflow.\n")
              if findings:
                  out.write("\n| Severity | Package | Advisory |\n| --- | --- | --- |\n")
                  for severity, package, advisory in sorted(findings):
                      safe = lambda value: str(value).replace("|", "\\|").replace("\n", " ")
                      out.write(f"| {safe(severity)} | {safe(package)} | {safe(advisory)} |\n")
          if counts["CRITICAL"] or counts["HIGH"]:
              raise SystemExit("Trivy found HIGH or CRITICAL vulnerabilities; scan recorded and build validation failed")
          PY

      - name: Remove temporary builder and local image
        if: always()
        shell: bash
        env:
          SOURCE_SHA: ${{ inputs.source_sha }}
        run: |
          set +e
          builder_id=$(docker ps -aq --filter name=buildx_buildkit_ornigami-external-rehearsal | head -n1)
          if [[ -n "$builder_id" ]] && [[ "$(docker inspect "$builder_id" --format '{{.State.Running}}' 2>/dev/null)" == true ]]; then
            docker exec "$builder_id" sh -c '
              for path in memory.max memory.swap.max memory.peak memory.events cpu.max cpu.stat; do
                printf "==%s==\\n" "$path"
                cat "/sys/fs/cgroup/$path"
              done
            ' > "$RUNNER_TEMP/builder-final.txt"
            if [[ -s "$RUNNER_TEMP/builder-final.txt" ]]; then
              {
                printf '\n### Final builder cgroup counters before cleanup\n\n'
                printf '%s\n' '```text'
                cat "$RUNNER_TEMP/builder-final.txt"
                printf '%s\n' '```'
              } >> "$GITHUB_STEP_SUMMARY"
            fi
          else
            printf '\n### Final builder cgroup counters\n\n- Unavailable: no running temporary builder remained for capture.\n' >> "$GITHUB_STEP_SUMMARY"
          fi
          docker buildx rm ornigami-external-rehearsal >/dev/null 2>&1 || true
          docker rm -f ornigami-external-smoke >/dev/null 2>&1 || true
          docker image rm "ornigami:rehearsal-${SOURCE_SHA}" >/dev/null 2>&1 || true
