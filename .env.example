# Copy only the values needed by your local features into .env.local.
# Production values belong in the deployment environment, never in Git.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# AUTH_SECRET=replace-with-a-private-random-secret
# TOKEN_ENCRYPTION_KEY=replace-with-a-private-encryption-key
# Free launch: keep paid AI disabled. Future opt-in requires budget and provider review.
# OPENAI_ENABLED=false
# OPENAI_API_KEY=replace-with-your-provider-key
# STRIPE_SECRET_KEY=replace-with-your-test-mode-key
# STRIPE_WEBHOOK_SECRET=replace-with-your-endpoint-secret
# GOOGLE_CLIENT_ID=replace-with-your-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
# CRON_SECRET=replace-with-a-private-random-secret
# RESEND_API_KEY=replace-with-your-provider-key
# Mail sending remains disabled unless the reviewed cross-app authority enrollment is configured.
# QR_MAIL_ENABLED=false
# QR_MAIL_AUTHORITY_URL=https://authority.example.invalid
# QR_MAIL_BOOSTER_AUTHORITY_TOKEN=replace-with-booster-enrollment-token
# QR_MAIL_BOOSTER_SOURCE_ID=reviewed-booster-source-id
# QR_MAIL_BOOSTER_SOURCE_REVISION=reviewed-booster-source-revision
# QR_MAIL_BOOSTER_SOURCE_REF=reviewed-booster-manifest-reference
# QR_MAIL_BOOSTER_KEY_BINDING_REF=reviewed-booster-key-binding-reference
# QR_MAIL_BOOSTER_POLICY_ID=reviewed-booster-policy-id
# QR_MAIL_BOOSTER_ACCOUNT_BINDING=reviewed-booster-account-binding
# QR_MAIL_BOOSTER_BUSINESS_ID=reviewed-booster-central-business-id
# QR_MAIL_DIRECT_AUTHORITY_TOKEN=replace-with-direct-enrollment-token
# QR_MAIL_DIRECT_SOURCE_ID=reviewed-direct-source-id
# QR_MAIL_DIRECT_SOURCE_REVISION=reviewed-direct-source-revision
# QR_MAIL_DIRECT_SOURCE_REF=reviewed-direct-manifest-reference
# QR_MAIL_DIRECT_KEY_BINDING_REF=reviewed-direct-key-binding-reference
# QR_MAIL_DIRECT_POLICY_ID=reviewed-direct-policy-id
# QR_MAIL_DIRECT_ACCOUNT_BINDING=reviewed-direct-account-binding
# QR_MAIL_DIRECT_BUSINESS_ID=reviewed-direct-central-business-id
# EMAIL_FROM=noreply@your-verified-domain.example
# REPLY_TO_EMAIL=support@your-domain.example
# RESEND_WEBHOOK_SECRET=whsec_replace-with-the-endpoint-signing-secret
# REVIEW_BOOSTER_UNSUBSCRIBE_SECRET=replace-with-a-private-random-secret
# Enable only after controlled provider shape, permission and UI acceptance.
RESEND_RECONCILIATION_ENABLED=false
# Account deletion has separate retention/provider/operator activation gates.
PRIVACY_ACCOUNT_DELETION_ENABLED=false
# Two independent flags are required for the guarded cleanup policies to mutate data.
PRIVACY_RETENTION_ENABLED=false
PRIVACY_RETENTION_APPLY=false
# NEXT_PUBLIC_SENTRY_DSN=replace-with-your-project-dsn
