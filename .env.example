# Copy only the values needed by your local features into .env.local.
# Production values belong in the deployment environment, never in Git.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# AUTH_SECRET=replace-with-a-private-random-secret
# TOKEN_ENCRYPTION_KEY=replace-with-a-private-encryption-key
# OPENAI_API_KEY=replace-with-your-provider-key
# STRIPE_SECRET_KEY=replace-with-your-test-mode-key
# STRIPE_WEBHOOK_SECRET=replace-with-your-endpoint-secret
# GOOGLE_CLIENT_ID=replace-with-your-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
# CRON_SECRET=replace-with-a-private-random-secret
# RESEND_API_KEY=replace-with-your-provider-key
# EMAIL_FROM=noreply@your-verified-domain.example
# REPLY_TO_EMAIL=support@your-domain.example
# RESEND_WEBHOOK_SECRET=whsec_replace-with-the-endpoint-signing-secret
# REVIEW_BOOSTER_UNSUBSCRIBE_SECRET=replace-with-a-private-random-secret
# Enable only after controlled provider shape, permission and UI acceptance.
RESEND_RECONCILIATION_ENABLED=false
# Account deletion has separate retention/provider/operator activation gates.
PRIVACY_ACCOUNT_DELETION_ENABLED=false
# NEXT_PUBLIC_SENTRY_DSN=replace-with-your-project-dsn
