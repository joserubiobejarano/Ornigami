diff --git a/tests/a11-auth-restricted-session-contract.test.mts b/tests/a11-auth-restricted-session-contract.test.mts
new file mode 100644
index 0000000..ab8ea46
--- /dev/null
+++ b/tests/a11-auth-restricted-session-contract.test.mts
@@ -0,0 +1,83 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { loadTs } from "./auth-test-harness.mts";
+
+test("pending deletion keeps a resumable JWT but exposes only a restricted session", async () => {
+  let pending = false;
+  let lookupFails = false;
+  let deleted = false;
+  let currentVersion = 4;
+  const loaded = loadTs<{ authConfig: { callbacks: {
+    jwt(input: never): Promise<Record<string, unknown> | null>;
+    session(input: never): Promise<Record<string, unknown>>;
+  } } }>("src/auth.ts", {
+    overrides: {
+      "next-auth": { __esModule: true, default: () => ({ handlers: {}, auth: () => undefined, signIn: () => undefined, signOut: () => undefined }) },
+      "next-auth/providers/google": { __esModule: true, default: () => ({ id: "google", type: "oauth" }) },
+      "next-auth/providers/credentials": { __esModule: true, default: () => ({ id: "credentials", type: "credentials" }) },
+      "@/lib/db/users": {
+        findUserByEmail: async () => null,
+        findUserById: async (id: string) => {
+          if (lookupFails) throw new Error("database unavailable");
+          return id === "u1" && !deleted ? {
+            id,
+            auth_version: currentVersion,
+            privacy_deletion_requested_at: pending ? "2026-10-03T00:00:00.000Z" : null,
+          } : null;
+        },
+        ensureUserFromOAuth: async () => ({
+          id: "u1", auth_version: currentVersion,
+          privacy_deletion_requested_at: pending ? "2026-10-03T00:00:00.000Z" : null,
+        }),
+      },
+      "@/lib/auth-rate-limit": { clearCredentialsLoginFailures: async () => undefined, isCredentialsLoginRateLimited: async () => false, recordCredentialsLoginFailure: async () => undefined },
+      "@/lib/env": { getRequiredEnv: (name: string) => name },
+    },
+  });
+
+  const jwt = loaded.authConfig.callbacks.jwt;
+  const session = loaded.authConfig.callbacks.session;
+  const token = await jwt({
+    token: {},
+    user: { id: "u1", email: "person@example.com", name: "Person", authVersion: 4 },
+    account: null,
+  } as never);
+  assert.deepEqual(token, { sub: "u1", authVersion: 4, privacyDeletionPending: false });
+
+  pending = true;
+  const refreshed = await jwt({ token, user: undefined, account: null } as never);
+  assert.deepEqual(refreshed, { sub: "u1", authVersion: 4, privacyDeletionPending: true });
+  const restricted = await session({
+    session: { user: { id: "u1", email: "person@example.com", name: "Person", image: "image-url", authVersion: 4 } },
+    token: refreshed,
+  } as never);
+  assert.deepEqual(restricted, {
+    user: {},
+    deletionUserId: "u1",
+    accountLifecycle: "deleting",
+  });
+
+  const retried = await jwt({ token: refreshed, user: undefined, account: null } as never);
+  assert.deepEqual(retried, refreshed, "the same restricted session remains usable for deletion retry");
+
+  const oauthReauth = await jwt({
+    token: {},
+    user: { id: "google-id", email: "person@example.com", name: "New provider name" },
+    account: { type: "oauth", provider: "google" },
+  } as never);
+  assert.deepEqual(oauthReauth, { sub: "u1", authVersion: 4, privacyDeletionPending: true },
+    "OAuth reauthentication of a frozen account produces only a restricted token");
+
+  currentVersion = 5;
+  assert.equal(await jwt({ token: refreshed, user: undefined, account: null } as never), null,
+    "a stale auth version cannot recover the frozen account");
+  currentVersion = 4;
+  deleted = true;
+  assert.equal(await jwt({ token: refreshed, user: undefined, account: null } as never), null,
+    "the old token stops working after final row deletion");
+  deleted = false;
+
+  lookupFails = true;
+  assert.equal(await jwt({ token: refreshed, user: undefined, account: null } as never), null,
+    "a lookup failure fails closed instead of granting restricted access");
+});
diff --git a/tests/a11-restricted-proxy-contract.test.mts b/tests/a11-restricted-proxy-contract.test.mts
new file mode 100644
index 0000000..08b9573
--- /dev/null
+++ b/tests/a11-restricted-proxy-contract.test.mts
@@ -0,0 +1,57 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { loadTs } from "./auth-test-harness.mts";
+
+class FakeNextResponse extends Response {
+  static next() { return new FakeNextResponse("next"); }
+  static redirect(url: URL, status = 307) {
+    return new FakeNextResponse(null, { status, headers: { Location: url.href } });
+  }
+  static rewrite(url: URL) { return new FakeNextResponse(url.href); }
+  static json(value: unknown, init?: ResponseInit) {
+    return new FakeNextResponse(JSON.stringify(value), {
+      ...init,
+      headers: { "Content-Type": "application/json", ...(init?.headers as Record<string, string> | undefined) },
+    });
+  }
+}
+
+test("restricted deletion session reaches only recovery, retry, and Auth.js", async () => {
+  const loaded = loadTs<{ proxy: (request: unknown) => Promise<Response> }>("src/proxy.ts", {
+    overrides: {
+      "next/server": { NextResponse: FakeNextResponse },
+      "@/auth": { auth: (handler: (request: unknown) => Promise<Response>) => handler },
+      "@/lib/app-base-url": { getAppBaseUrl: (request: { nextUrl: URL }) => request.nextUrl.origin },
+      "@/lib/db/access": { getMiddlewareAccessState: async () => ({ hasGbp: false, hasRepliesAccess: false }) },
+      "@/lib/safe-logger": { safeLogger: { error: () => undefined } },
+      "@/lib/disconnected-access-policy": {
+        shouldRedirectToGoogleConnect: () => false,
+        shouldRedirectAfterAccessResolutionError: () => false,
+      },
+      "@/lib/security-headers": { buildContentSecurityPolicy: () => "default-src 'self'" },
+    },
+  });
+
+  const request = (path: string, method = "GET") => ({
+    url: `https://example.test${path}`,
+    method,
+    nextUrl: new URL(`https://example.test${path}`),
+    headers: new Headers(),
+    cookies: { get: () => undefined },
+    auth: { user: {}, deletionUserId: "u1", accountLifecycle: "deleting" },
+  });
+
+  const dashboard = await loaded.proxy(request("/dashboard"));
+  assert.equal(dashboard.status, 302);
+  assert.equal(dashboard.headers.get("location"), "https://example.test/account/deletion");
+
+  const billing = await loaded.proxy(request("/api/stripe/checkout", "POST"));
+  assert.equal(billing.status, 403);
+  const exportApi = await loaded.proxy(request("/api/privacy/export"));
+  assert.equal(exportApi.status, 403);
+
+  assert.equal((await loaded.proxy(request("/api/privacy/delete", "POST"))).status, 200);
+  assert.equal((await loaded.proxy(request("/api/privacy/delete", "GET"))).status, 403);
+  assert.equal((await loaded.proxy(request("/api/auth/signout", "POST"))).status, 200);
+  assert.equal((await loaded.proxy(request("/account/deletion"))).status, 200);
+});
