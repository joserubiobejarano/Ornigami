  "globalVulnerabilityRecord": {
    "Title": "zziplib: zziplib: Denial of Service via out-of-bounds read in ZIP central directory parsing",
    "Description": "Zziplib through 0.13.80 contains an out-of-bounds read vulnerability in zzip/mmapped.c that allows attackers to over-read heap memory via a crafted ZIP central directory. Attackers can craft an end-of-central-directory record placing the first entry near the buffer end, causing zzip_disk_entry_strdup_name to read past the buffer and crash the application.",
    "Severity": "MEDIUM",
    "CweIDs": [
      "CWE-125"
    ],
    "VendorSeverity": {
      "redhat": 2
    },
    "CVSS": {
