{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ornigami.example/schemas/campaign-lab-acceptance-manifest.json",
  "title": "Campaign lab acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["approved", "proposed"] },
    "selfTest": { "type": "boolean" },
    "purpose": { "type": "string" },
    "template": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "product", "image"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "url": { "type": "string" },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          },
          "offer": { "type": ["string", "null"] },
          "destination": { "type": ["string", "null"], "format": "uri" },
          "cta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" }
            }
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "alt", "sha256", "label"],
            "properties": {
              "path": { "type": ["string", "null"] },
              "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
              "label": { "type": ["string", "null"] },
              "alt": { "type": ["string", "null"] },
              "note": { "type": "string" }
            }
          },
          "copyStress": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "fixtures": {
            "items": {
              "required": ["offer", "destination"],
              "properties": {
                "offer": { "type": "string", "minLength": 1 },
                "destination": { "type": "string", "format": "uri" },
                "image": {
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "alt": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
